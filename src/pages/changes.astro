---
import Base from '../layouts/Base.astro';
import { execSync } from 'node:child_process';

// Change tracker built from the repo's git history at build time.
// Every push to main redeploys the site, so this page is always current.
// Each change is labelled with the git author who made it. Email addresses are
// deliberately not shown because the site is public.

const REPO_URL = 'https://github.com/rd-code-storage/iktva';
const RS = '\x1e'; // record separator between commits
const US = '\x1f'; // unit separator between fields

interface FileChange {
  status: string;
  path: string;
}

interface Change {
  hash: string;
  short: string;
  author: string;
  date: string;
  subject: string;
  body: string;
  withClaude: boolean;
  files: FileChange[];
}

const statusLabels: Record<string, string> = {
  A: 'Added',
  M: 'Modified',
  D: 'Deleted',
  R: 'Renamed',
  C: 'Copied',
  T: 'Type changed',
};

let changes: Change[] = [];
let historyError = '';

try {
  const raw = execSync(
    'git log --no-merges --name-status --format=%x1e%H%x1f%an%x1f%aI%x1f%s%x1f%b%x1f',
    { encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 },
  );

  changes = raw
    .split(RS)
    .filter((chunk) => chunk.trim())
    .map((chunk) => {
      const [hash, author, date, subject, body, rest = ''] = chunk.split(US);
      const files = rest
        .split('\n')
        .map((line) => line.trim())
        .filter(Boolean)
        .map((line) => {
          const parts = line.split('\t');
          const code = parts[0].charAt(0);
          // Renames and copies list "old<TAB>new"; show the new path.
          return { status: statusLabels[code] ?? code, path: parts[parts.length - 1] };
        })
        .filter((f) => !f.path.endsWith('.gitkeep'));

      const isClaudeAuthor = author.trim().toLowerCase() === 'claude';
      return {
        hash,
        short: hash.slice(0, 7),
        author: author.trim(),
        date,
        subject: subject.trim(),
        body: body
          .split('\n')
          .filter((l) => !/^co-authored-by:/i.test(l.trim()))
          .join('\n')
          .trim(),
        withClaude: !isClaudeAuthor && /co-authored-by:\s*claude/i.test(body),
        files,
      };
    });
} catch (err) {
  historyError = 'The change history could not be read when this page was built.';
}

const authors = [...new Set(changes.map((c) => c.author))].sort();
const countFor = (name: string) => changes.filter((c) => c.author === name).length;

function formatDate(iso: string): string {
  return new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/London',
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  }).format(new Date(iso));
}

function assetUrl(path: string): string | null {
  return path.startsWith('public/') ? `${import.meta.env.BASE_URL}${path.slice('public/'.length)}` : null;
}
---

<Base title="Changes | IKTVA 2027" description="Every change made to the IKTVA 2027 knowledge base, and who made it.">
  <section class="changes-page">
    <div class="container">
      <h1 class="page-title animate-in" style="--delay: 0.1s">Changes</h1>
      <p class="page-desc animate-in" style="--delay: 0.2s">
        Every change made to this site and its files, newest first, labelled with who made it.
        This list is generated from the
        <a href={`${REPO_URL}/commits/main`} class="inline-link">GitHub history</a> on each deploy,
        so it can't drift from what actually happened. Times are UK time.
      </p>

      {historyError ? (
        <p class="history-error">{historyError}</p>
      ) : (
        <>
          <div class="filters animate-in" style="--delay: 0.25s" role="group" aria-label="Filter changes by person">
            <button class="filter active" data-author="all" aria-pressed="true">
              All <span class="count">{changes.length}</span>
            </button>
            {authors.map((name) => (
              <button class="filter" data-author={name} aria-pressed="false">
                {name} <span class="count">{countFor(name)}</span>
              </button>
            ))}
          </div>

          <ol class="change-list">
            {changes.map((c) => (
              <li class="change" data-author={c.author}>
                <div class="change-dot"></div>
                <div class="change-meta">
                  <span class="change-author">{c.author}</span>
                  {c.withClaude && <span class="change-tag">with Claude</span>}
                  <span class="change-date">{formatDate(c.date)}</span>
                  <a href={`${REPO_URL}/commit/${c.hash}`} class="change-hash" title="View this change on GitHub">
                    {c.short}
                  </a>
                </div>
                <h2 class="change-title">{c.subject}</h2>
                {c.body && <p class="change-body">{c.body}</p>}
                {c.files.length > 0 && (
                  <details class="change-files">
                    <summary>{c.files.length} file{c.files.length === 1 ? '' : 's'} changed</summary>
                    <ul>
                      {c.files.map((f) => {
                        const url = f.status !== 'Deleted' ? assetUrl(f.path) : null;
                        return (
                          <li>
                            <span class={`file-status status-${f.status.toLowerCase().replace(' ', '-')}`}>{f.status}</span>
                            {url ? <a href={url} class="file-path">{f.path}</a> : <span class="file-path">{f.path}</span>}
                          </li>
                        );
                      })}
                    </ul>
                  </details>
                )}
              </li>
            ))}
          </ol>
        </>
      )}
    </div>
  </section>
</Base>

<style>
  .changes-page {
    min-height: 100vh;
    padding-top: calc(var(--header-height) + var(--space-xl));
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  .page-desc {
    color: var(--color-fg-muted);
    margin-top: var(--space-xs);
    margin-bottom: var(--space-md);
    max-width: 640px;
  }

  .inline-link {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .history-error {
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .filter {
    font-family: var(--font-body);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--color-border);
    background: none;
    color: var(--color-fg-muted);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter:hover {
    color: var(--color-fg);
    border-color: var(--color-fg-muted);
  }

  .filter.active {
    background: var(--color-fg);
    border-color: var(--color-fg);
    color: var(--color-bg);
  }

  .count {
    font-family: var(--font-mono);
    opacity: 0.7;
    margin-left: 0.25rem;
  }

  .change-list {
    list-style: none;
    border-left: 2px solid var(--color-border);
    padding-left: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .change {
    position: relative;
  }

  .change[hidden] {
    display: none;
  }

  .change-dot {
    position: absolute;
    left: calc(-1 * var(--space-md) - 5px);
    top: 0.45rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .change-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    font-size: 0.75rem;
  }

  .change-author {
    font-weight: 600;
    color: var(--color-fg);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .change-tag {
    font-size: 0.6875rem;
    color: var(--color-fg-muted);
    border: 1px solid var(--color-border);
    padding: 0 0.375rem;
  }

  .change-date,
  .change-hash {
    font-family: var(--font-mono);
    color: var(--color-fg-muted);
  }

  .change-hash:hover {
    color: var(--color-accent);
  }

  .change-title {
    font-size: 1.125rem;
    margin-top: 0.375rem;
  }

  .change-body {
    font-size: 0.875rem;
    color: var(--color-fg-muted);
    margin-top: 0.5rem;
    line-height: 1.5;
    max-width: 640px;
    white-space: pre-line;
  }

  .change-files {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
  }

  .change-files summary {
    cursor: pointer;
    color: var(--color-fg-muted);
    width: fit-content;
  }

  .change-files summary:hover {
    color: var(--color-fg);
  }

  .change-files ul {
    list-style: none;
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .change-files li {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    min-width: 0;
  }

  .file-status {
    flex: none;
    width: 5.5rem;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-fg-muted);
  }

  .status-added { color: #16a34a; }
  .status-deleted { color: #dc2626; }

  .file-path {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    overflow-wrap: anywhere;
    min-width: 0;
  }

  a.file-path:hover {
    color: var(--color-accent);
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const items = document.querySelectorAll<HTMLElement>('.change');

  function apply(author: string) {
    buttons.forEach((b) => {
      const on = b.dataset.author === author;
      b.classList.toggle('active', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    items.forEach((item) => {
      item.hidden = author !== 'all' && item.dataset.author !== author;
    });
    const url = new URL(window.location.href);
    if (author === 'all') url.searchParams.delete('by');
    else url.searchParams.set('by', author);
    history.replaceState(null, '', url);
  }

  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.author ?? 'all')));

  const initial = new URLSearchParams(window.location.search).get('by');
  if (initial && [...buttons].some((b) => b.dataset.author === initial)) apply(initial);
</script>
