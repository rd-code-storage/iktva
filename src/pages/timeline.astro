---
import Base from '../layouts/Base.astro';
import {
  allEvents,
  summaries,
  timelineUpdatedAt,
  dayKey,
  timeOf,
  longDay,
  stamp,
  formatSize,
  kindLabels,
} from '../content/timeline';

// Group events by UK day, newest first
const days = new Map<string, typeof allEvents>();
for (const e of allEvents) {
  const k = e.kind === 'note' ? e.date.slice(0, 10) : dayKey(e.date);
  if (!days.has(k)) days.set(k, []);
  days.get(k)!.push(e);
}
const summaryByDay = new Map(summaries.map((s) => [s.date, s.summary]));
const people = [...new Set(allEvents.map((e) => e.by).filter((b) => b && b !== 'Tracker'))].sort();

const typeOf = (kind: string, category: string) =>
  kind === 'note' ? 'notes' : kind === 'render' || category === 'video' ? 'renders' : 'files';
---

<Base title="Timeline | IKTVA 2027" description="Everything that has happened on the project, day by day.">
  <section class="kb-page">
    <div class="container">
      <h1 class="kb-title animate-in" style="--delay: 0.1s">Timeline</h1>
      <p class="kb-desc animate-in" style="--delay: 0.2s">
        Everything that has happened on the project, day by day. File activity in the animation folder
        (<span class="kb-mono">U:\…\02. Animation</span>: After Effects, Illustrator, Photoshop, 3D, Assets and Exports)
        is recorded automatically, and project
        updates are added by the team. Changes to this site itself are on the <a href={`${import.meta.env.BASE_URL}changes/`}>Changes</a> page.
        {timelineUpdatedAt && <> Files last checked {stamp(timelineUpdatedAt)} (UK time).</>}
      </p>

      <div class="kb-filters" role="group" aria-label="Filter by type">
        <button class="kb-filter active" data-type="all" aria-pressed="true">All</button>
        <button class="kb-filter" data-type="renders" aria-pressed="false">Renders &amp; previews</button>
        <button class="kb-filter" data-type="files" aria-pressed="false">Scenes &amp; files</button>
        <button class="kb-filter" data-type="notes" aria-pressed="false">Project updates</button>
      </div>
      {people.length > 1 && (
        <div class="kb-filters" role="group" aria-label="Filter by person">
          <button class="kb-filter person active" data-person="all" aria-pressed="true">Everyone</button>
          {people.map((p) => (
            <button class="kb-filter person" data-person={p} aria-pressed="false">{p}</button>
          ))}
        </div>
      )}

      <div class="days">
        {[...days.entries()].map(([day, events]) => (
          <section class="day" data-day={day}>
            <h2 class="day-title">{longDay(day)}</h2>
            {summaryByDay.has(day) && <p class="day-summary">{summaryByDay.get(day)}</p>}
            <ol class="events">
              {events.map((e) => (
                <li class={`event kind-${e.kind}`} data-type={typeOf(e.kind, e.category)} data-person={e.by || 'all'}>
                  <span class="event-time">{e.kind === 'note' ? '' : timeOf(e.date)}</span>
                  <div class="event-body">
                    <div class="event-head">
                      <span class="kb-pill">{kindLabels[e.kind] ?? e.kind}</span>
                      <span class="event-title">{e.title}</span>
                    </div>
                    <div class="event-meta">
                      {e.by && e.kind !== 'note' && <span class="event-by">{e.by}</span>}
                      {e.detail && <span>{e.detail}</span>}
                      {e.size > 0 && <span>{formatSize(e.size)}</span>}
                      {e.backfill && <span class="muted">dated by file modified time</span>}
                    </div>
                    {e.path && <div class="kb-mono event-path">{e.path}</div>}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .day {
    margin-bottom: var(--space-md);
  }

  .day[hidden] { display: none; }

  .day-title {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 0.75rem;
  }

  .day-summary {
    font-size: 0.9375rem;
    max-width: 720px;
    margin-bottom: 0.75rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--color-accent);
  }

  .events {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .event {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: 0.75rem;
    min-width: 0;
  }

  .event[hidden] { display: none; }

  .event-time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    padding-top: 0.2rem;
  }

  .event-body { min-width: 0; }

  .event-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
  }

  .event-title {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .kind-note .event-title { color: var(--color-accent); }
  .kind-version .kb-pill,
  .kind-added .kb-pill { color: #16a34a; border-color: currentColor; }
  .kind-deleted .kb-pill { color: #dc2626; border-color: currentColor; }
  .kind-render .kb-pill { color: var(--color-accent); border-color: currentColor; }

  .event-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.125rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    margin-top: 0.125rem;
  }

  .event-by {
    color: var(--color-fg);
    font-weight: 500;
  }

  .muted { opacity: 0.75; font-style: italic; }

  .event-path {
    font-size: 0.6875rem;
    color: var(--color-fg-muted);
    margin-top: 0.125rem;
  }
</style>

<script>
  const typeButtons = document.querySelectorAll<HTMLButtonElement>('.kb-filter[data-type]');
  const personButtons = document.querySelectorAll<HTMLButtonElement>('.kb-filter.person');
  const events = document.querySelectorAll<HTMLElement>('.event');
  const days = document.querySelectorAll<HTMLElement>('.day');
  let type = 'all';
  let person = 'all';

  function apply() {
    events.forEach((e) => {
      const okType = type === 'all' || e.dataset.type === type;
      const okPerson = person === 'all' || e.dataset.person === person || e.dataset.type === 'notes';
      e.hidden = !(okType && okPerson);
    });
    days.forEach((d) => {
      d.hidden = !d.querySelector('.event:not([hidden])');
    });
  }

  function select(buttons: NodeListOf<HTMLButtonElement>, btn: HTMLButtonElement) {
    buttons.forEach((b) => {
      b.classList.toggle('active', b === btn);
      b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
    });
  }

  typeButtons.forEach((b) =>
    b.addEventListener('click', () => {
      type = b.dataset.type ?? 'all';
      select(typeButtons, b);
      apply();
    }),
  );
  personButtons.forEach((b) =>
    b.addEventListener('click', () => {
      person = b.dataset.person ?? 'all';
      select(personButtons, b);
      apply();
    }),
  );
</script>
